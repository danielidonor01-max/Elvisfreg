---
/**
 * The five lifecycle stages as a tab strip over one panel: the stage's
 * headline, method and links on the left, the documents it ends in on the
 * right. Native ARIA tabs with arrow-key movement; without JavaScript every
 * panel shows in order and the strip is hidden.
 */
import { STAGES } from '../data/stages';
import { serviceBySlug } from '../data/services';
import Button from './Button.astro';
---

<div class="stage-tabs" data-stage-tabs>
  <div class="tabs-strip" role="tablist" aria-label="Lifecycle stages">
    {STAGES.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${s.slug}`}
        class="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`panel-${s.slug}`}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="data" aria-hidden="true">{s.id}</span>
        <span class="sr-only">Stage {s.id}, </span>
        <span>{s.short}</span>
      </button>
    ))}
  </div>

  {STAGES.map((s, i) => (
    <section role="tabpanel" id={`panel-${s.slug}`} class="tab-panel" aria-labelledby={`tab-${s.slug}`} hidden={i !== 0}>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="text-[0.9375rem] text-ink-muted"><span class="data" aria-hidden="true">{s.id}</span><span class="sr-only">Stage {s.id}, </span><span class="ml-3">{s.name}</span></p>
          <h3 class="h2 mt-3">{s.headline}</h3>
          <p class="measure mt-5 text-ink-muted">{s.body}</p>
          <ul class="list-none m-0 p-0 mt-6 flex flex-wrap gap-x-6 gap-y-2">
            {s.services.map((slug) => { const svc = serviceBySlug(slug)!; return <li><a href={`/services/${svc.slug}/`} class="link">{svc.title}</a></li>; })}
          </ul>
          <p class="mt-8">
            <Button href={`/contact/?service=${s.services[0]}`} variant="primary">{s.cta}</Button>
          </p>
        </div>
        <div class="lg:col-span-5">
          <p class="text-[0.9375rem] text-ink-muted">What you receive</p>
          <ol class="doc-cards list-none m-0 p-0 mt-4">
            {s.deliverables.map((d, j) => (
              <li class="doc-card" style={`--i:${j}`}>
                <svg class="doc-glyph" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                <span class="text-[0.9375rem]">{d}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  ))}
</div>

<noscript>
  <style>
    [data-stage-tabs] [role="tabpanel"][hidden] { display: block !important; }
    [data-stage-tabs] [role="tablist"] { display: none; }
  </style>
</noscript>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-stage-tabs]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
      const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
          const on = i === j;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panels[j].hidden = !on;
          panels[j].classList.toggle('is-entering', on);
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          let j = -1;
          if (e.key === 'ArrowRight') j = (i + 1) % n;
          else if (e.key === 'ArrowLeft') j = (i - 1 + n) % n;
          else if (e.key === 'Home') j = 0;
          else if (e.key === 'End') j = n - 1;
          if (j >= 0) { e.preventDefault(); select(j, true); }
        });
      });
    });
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
