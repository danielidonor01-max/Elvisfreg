---
/**
 * The horizontal lockup defined once per page as an SVG <symbol>. Header and
 * footer reference it with <use>, so the 22 kB of wordmark paths ship once.
 * Custom properties (--ef-flame, --ef-ink) inherit into the <use> shadow tree,
 * so the theme still applies.
 */
import raw from '../../assets/brand/logo/lockup-h-themed.svg?raw';

const inner = raw
  .replace(/<\?xml[^>]*>\s*/, '')
  .replace(/<title>.*?<\/title>\s*/, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '');
---

<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
  <symbol id="ef-lockup" viewBox="0 0 246 60" set:html={inner} />
</svg>
