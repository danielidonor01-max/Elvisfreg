---
import Lockup from './Lockup.astro';
import ThemeToggle from './ThemeToggle.astro';
import Drafting from './Drafting.astro';
import { SITE, OFFICES, NAV } from '../data/site';
const year = new Date().getFullYear();
const hq = OFFICES.find((o) => o.isHq)!;
const others = OFFICES.filter((o) => !o.isHq).map((o) => o.city === 'Ikeja' ? 'Lagos' : o.city);
---

<footer class="relative border-t border-line mt-auto">
  <Drafting />
  <div class="relative z-10 wrap py-14 md:py-20 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" class="inline-block no-underline" aria-label={`${SITE.name}, home`}>
        <Lockup class="w-[196px]" decorative />
      </a>
      <p class="text-[0.9375rem] text-ink-muted mt-5 max-w-[36ch]">{SITE.shortDescription}</p>
      <p class="data text-ink-muted mt-5"><span class="whitespace-nowrap">RC {SITE.rc}</span><span class="mx-2" aria-hidden="true">/</span><span class="whitespace-nowrap">Incorporated {SITE.incorporatedLabel}</span></p>
    </div>

    <div class="md:col-span-4">
      <h2 class="text-[0.9375rem] font-medium mb-2">{hq.name}</h2>
      <address class="not-italic text-[0.9375rem] text-ink-muted leading-relaxed">
        {hq.lines.map((l) => <span class="block">{l}</span>)}
      </address>
      <p class="mt-4 text-[0.9375rem]"><a href="/contact/#offices" class="link-quiet">{others.join(' and ')} offices</a></p>
    </div>

    <div class="md:col-span-4 grid grid-cols-2 gap-8">
      <div>
        <h2 class="text-[0.9375rem] font-medium mb-2">Contact</h2>
        <ul class="list-none m-0 p-0 flex flex-col gap-1.5 text-[0.9375rem]">
          <li><a href={`tel:${SITE.phoneE164}`} class="link-quiet num">{SITE.phoneDisplay}</a></li>
          <li><a href={SITE.whatsapp} rel="noopener" target="_blank" class="link-quiet">WhatsApp</a></li>
          <li><a href={`mailto:${SITE.email}`} class="link-quiet break-words">{SITE.email}</a></li>
        </ul>
      </div>
      <nav aria-label="Footer">
        <ul class="list-none m-0 p-0 flex flex-col gap-1.5 text-[0.9375rem]">
          {NAV.map((n) => <li><a href={n.href} class="link-quiet">{n.label}</a></li>)}
          <li><a href="/privacy/" class="link-quiet">Privacy</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="relative z-10 border-t border-line">
    <div class="wrap py-5 flex flex-wrap items-center justify-between gap-4 text-[0.9375rem] text-ink-muted">
      <p>© {year} {SITE.name}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
