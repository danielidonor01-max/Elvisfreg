---
import Arc from './Arc.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../data/site';
import { STAGES, stageById } from '../data/stages';
import { SERVICES } from '../data/services';

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
// Services in lifecycle order, each once, with its primary stage as a tag.
const services = [...SERVICES].sort((a, b) => a.stages[0].localeCompare(b.stages[0]));
---

<header class="sticky top-0 z-40 bg-bg border-b border-line">
  <div class="wrap relative flex items-center justify-between gap-6 h-16">
    <a href="/" class="shrink-0 no-underline flex items-center gap-2.5" aria-label={`${SITE.name}, home`}>
      <Arc class="w-[40px] md:w-[46px]" />
      <svg class="wordmark h-[26px] md:h-[30px] w-auto" viewBox="0 0 137 44" aria-hidden="true" focusable="false"><use href="#ef-wordmark" width="137" height="44" /></svg>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-1">
      {NAV.map((item) =>
        item.label === 'Services' ? (
          <details class="services-menu" data-services-menu>
            <summary class:list={['nav-link list-none cursor-pointer', { 'is-active': isActive(item.href) }]} aria-haspopup="true">
              {item.label}
            </summary>
            <div class="menu-panel absolute left-6 right-6 md:left-8 md:right-8 top-full mt-2 bg-surface border border-line rounded-md p-6 grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]">
              {services.map((s) => (
                <a href={`/services/${s.slug}/`} class="flex items-baseline gap-3 py-1 link-quiet">
                  <span class="data text-ink-muted w-6 shrink-0" aria-hidden="true">{s.stages[0]}</span>
                  <span class="sr-only">Stage {s.stages[0]}, {stageById(s.stages[0]).short}. </span>
                  <span>{s.title}</span>
                </a>
              ))}
              <a href="/services/" class="lg:col-start-3 lg:row-start-1 lg:row-span-4 self-start font-medium link-quiet lg:pl-8 lg:border-l lg:border-line">All services</a>
            </div>
          </details>
        ) : (
          <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
      <a href={`tel:${SITE.phoneE164}`} class="hidden lg:inline-flex items-center min-h-11 px-3 link-quiet num text-[0.9375rem] text-ink-muted hover:text-ink">{SITE.phoneDisplay}</a>
      <a href="/contact/" class="btn btn-primary header-cta ml-2" data-header-cta>Request a quotation</a>
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-xs border border-transparent hover:border-line transition-colors"
      data-menu-button
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg class="menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path class="bar-1" d="M4 7h16" /><path class="bar-2" d="M4 12h16" /><path class="bar-3" d="M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden border-t border-line bg-bg" data-mobile-menu inert>
    <div>
      <nav aria-label="Primary, mobile" class="wrap py-6 flex flex-col gap-2">
        <a href="/services/" class="py-2.5 font-medium link-quiet self-start">Services</a>
        <ul class="list-none m-0 p-0 pl-4 flex flex-col gap-1 border-l border-line mb-2">
          {services.map((s) => <li><a href={`/services/${s.slug}/`} class="inline-block py-2 link-quiet text-[0.9375rem]">{s.short}</a></li>)}
        </ul>
        {NAV.filter((n) => n.label !== 'Services').map((item) => (
          <a href={item.href} class="py-2.5 font-medium link-quiet self-start">{item.label}</a>
        ))}
        <a href="/contact/" class="btn btn-primary mt-3 self-start">Request a quotation</a>
        <div class="mt-6 pt-6 border-t border-line">
          <ThemeToggle />
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  summary::-webkit-details-marker { display: none; }
  .wordmark { --ef-flame: var(--flame); --ef-ink: var(--ink); display: block; }
  .menu-icon path { transform-origin: 12px 12px; transition: transform 240ms var(--ease-mech), opacity 160ms var(--ease-mech); }
  [aria-expanded="true"] .bar-1 { transform: translateY(5px) rotate(45deg); }
  [aria-expanded="true"] .bar-2 { opacity: 0; }
  [aria-expanded="true"] .bar-3 { transform: translateY(-5px) rotate(-45deg); }
</style>

<script>
  function init() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (btn && menu && !btn.dataset.bound) {
      btn.dataset.bound = '1';
      const setOpen = (open: boolean) => {
        menu.classList.toggle('is-open', open);
        menu.inert = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      btn.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) { setOpen(false); btn.focus(); } });
    }
    const details = document.querySelector<HTMLDetailsElement>('[data-services-menu]');
    if (details && !details.dataset.bound) {
      details.dataset.bound = '1';
      document.addEventListener('click', (e) => { if (details.open && !details.contains(e.target as Node)) details.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && details.open) { details.open = false; details.querySelector('summary')?.focus(); } });
    }
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
