---
import Arc from './Arc.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../data/site';
import { STAGES } from '../data/stages';
import { serviceBySlug } from '../data/services';

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="sticky top-0 z-40 bg-bg border-b border-line">
  <div class="wrap relative flex items-center justify-between gap-6 h-16">
    <a href="/" class="shrink-0 no-underline flex items-center gap-2.5" aria-label={`${SITE.name}, home`}>
      <Arc class="w-[40px] md:w-[46px]" data-header-arc="" />
      <svg class="wordmark h-[26px] md:h-[30px] w-auto" viewBox="0 0 137 44" aria-hidden="true" focusable="false"><use href="#ef-wordmark" width="137" height="44" /></svg>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-1">
      {NAV.map((item) =>
        item.label === 'Services' ? (
          <details class="services-menu" data-services-menu>
            <summary class:list={['nav-link list-none cursor-pointer', { 'is-active': isActive(item.href) }]} aria-haspopup="true">
              {item.label}
            </summary>
            <div class="absolute left-6 right-6 md:left-8 md:right-8 top-full mt-2 bg-surface border border-line rounded-md p-6 grid grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-5">
              <a href="/services/" class="col-span-2 lg:col-span-5 font-medium no-underline hover:underline">All services</a>
              {STAGES.map((stage) => (
                <div>
                  <p class="text-[0.8125rem] font-medium text-ink-muted mb-1.5"><span class="data" aria-hidden="true">{stage.id}</span><span class="sr-only">Stage {stage.id}</span> {stage.short}</p>
                  <ul class="list-none m-0 p-0 flex flex-col gap-1">
                    {stage.services.map((slug) => {
                      const s = serviceBySlug(slug)!;
                      return <li><a href={`/services/${s.slug}/`} class="no-underline hover:underline text-[0.9375rem]">{s.short}</a></li>;
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
      <a href="/contact/" class="btn btn-primary ml-3">Request a quote</a>
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 rounded-xs border border-transparent hover:border-line"
      data-menu-button
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <div id="mobile-menu" class="md:hidden border-t border-line bg-bg" hidden data-mobile-menu>
    <nav aria-label="Primary, mobile" class="wrap py-6 flex flex-col gap-2">
      <a href="/services/" class="py-2.5 font-medium no-underline">Services</a>
      <ul class="list-none m-0 p-0 pl-4 flex flex-col gap-1 border-l border-line mb-2">
        {STAGES.flatMap((st) => st.services).filter((v, i, a) => a.indexOf(v) === i).map((slug) => {
          const s = serviceBySlug(slug)!;
          return <li><a href={`/services/${s.slug}/`} class="block py-2 no-underline text-[0.9375rem]">{s.short}</a></li>;
        })}
      </ul>
      {NAV.filter((n) => n.label !== 'Services').map((item) => (
        <a href={item.href} class="py-2.5 font-medium no-underline">{item.label}</a>
      ))}
      <a href="/contact/" class="btn btn-primary mt-3 self-start">Request a quote</a>
      <div class="mt-6 pt-6 border-t border-line">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.75rem; font-weight: 500; text-decoration: none; color: var(--ink-muted); border-bottom: 2px solid transparent; }
  .nav-link:hover { color: var(--ink); }
  .nav-link.is-active { color: var(--ink); border-bottom-color: var(--flame); }
  summary::-webkit-details-marker { display: none; }
  .wordmark { --ef-flame: var(--flame); --ef-ink: var(--ink); display: block; }
  .services-menu[open] > summary { color: var(--ink); }
</style>

<script>
  function init() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (btn && menu && !btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const open = menu.hidden;
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
    }
    // Close the services menu on outside click or Escape.
    const details = document.querySelector<HTMLDetailsElement>('[data-services-menu]');
    if (details && !details.dataset.bound) {
      details.dataset.bound = '1';
      document.addEventListener('click', (e) => {
        if (details.open && !details.contains(e.target as Node)) details.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) { details.open = false; details.querySelector('summary')?.focus(); }
      });
    }
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
