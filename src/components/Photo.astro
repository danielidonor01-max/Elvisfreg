---
/**
 * A photograph in a hard-edged frame (radius 0 — photos are prints), with a
 * slow zoom inside the frame on hover and AVIF/WebP derivatives at four widths.
 * `temp` marks a stand-in from a stock library, to be swapped for field photography.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;           // e.g. "3/2"; omit to fill the parent (parent must size it)
  sizes?: string;
  widths?: number[];
  priority?: boolean;       // eager + high fetch priority (the hero)
  temp?: boolean;
  parallax?: boolean;       // the picture drifts inside the frame with the scroll (motion layer)
  class?: string;
}

const {
  src, alt, ratio, sizes = '(min-width: 1024px) 33vw, 100vw',
  widths = [480, 800, 1200, 1600], priority = false, temp = false, parallax = false, class: cls = '',
} = Astro.props;
---

<figure class:list={['photo', cls, { 'photo-fill': !ratio, 'photo-parallax': parallax }]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
  {temp && <figcaption class="photo-temp" aria-label="Temporary stock image">Temporary image</figcaption>}
</figure>

<style>
  .photo { position: relative; margin: 0; overflow: hidden; background: var(--surface-2); }
  .photo-fill { position: absolute; inset: 0; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 900ms var(--ease-mech); }
  .photo:hover :global(img) { transform: scale(1.035); }
  .photo-temp { position: absolute; left: 0; bottom: 0; padding: 0.25rem 0.5rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.01em; background: rgba(11, 27, 43, 0.72); color: #fffbf9; }
  @media (prefers-reduced-motion: reduce) { .photo :global(img) { transition: none; } .photo:hover :global(img) { transform: none; } }
</style>
