---
/**
 * The left edge: a rail of dots, one per section of the page, with the current
 * section's number above and the theme button beneath, the whole group
 * centred vertically. The active dot stretches into a flame pill.
 * Sections are read from the page: those marked data-rail-section (the home
 * page numbers its own), otherwise every top-level section with a heading.
 * Pages with fewer than three sections get no rail, only the button.
 * Shows only where there is room beside the page.
 */
import ThemeToggle from './ThemeToggle.astro';
---

<div class="edge">
  <nav class="rail" aria-label="Sections on this page" data-rail hidden>
    <p class="rail-n data" data-rail-n aria-hidden="true"></p>
    <ol class="list-none m-0 p-0 flex flex-col items-center" data-rail-list></ol>
  </nav>
  <ThemeToggle />
</div>

<script>
  let ctrl: AbortController | null = null;

  function init() {
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const found = document.querySelector<HTMLElement>('[data-rail]');
    const main = document.getElementById('main');
    if (!found || !main) return;
    const rail = found;
    const list = rail.querySelector<HTMLElement>('[data-rail-list]')!;
    const num = rail.querySelector<HTMLElement>('[data-rail-n]')!;

    let sections = Array.from(main.querySelectorAll<HTMLElement>('[data-rail-section]'));
    const explicit = sections.length > 0;
    if (!explicit) sections = Array.from(main.querySelectorAll<HTMLElement>(':scope > section')).filter((s) => s.querySelector('h1, h2'));
    if (sections.length < 3) { rail.hidden = true; return; }

    const pad = (n: number) => String(n).padStart(2, '0');
    const items = sections.map((s, i) => {
      if (!s.id) s.id = `section-${i + 1}`;
      const n = explicit ? s.dataset.railSection || pad(i + 1) : pad(i + 1);
      const label = (s.querySelector('h1, h2')?.textContent || `Section ${n}`).trim().replace(/\s+/g, ' ');
      return { s, n, label };
    });
    list.replaceChildren(...items.map(({ s, n, label }) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${s.id}`; a.className = 'rail-dot'; a.setAttribute('aria-label', `${n}, ${label}`);
      li.appendChild(a);
      return li;
    }));
    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
    rail.hidden = false;

    let ticking = false;
    function update() {
      ticking = false;
      const mid = window.innerHeight * 0.5;
      let active = -1;
      items.forEach((it, i) => { if (it.s.getBoundingClientRect().top <= mid) active = i; });
      rail.classList.toggle('is-on', active >= 0);
      links.forEach((l, i) => {
        l.classList.toggle('is-active', i === active);
        if (i === active) l.setAttribute('aria-current', 'true'); else l.removeAttribute('aria-current');
      });
      if (active >= 0) num.textContent = items[active].n;
    }
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { signal });
    update();
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
