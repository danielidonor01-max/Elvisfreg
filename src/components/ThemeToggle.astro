---
/**
 * Theme switch as a single round button whose icon shows the state: a sun in
 * the light theme, a moon in the dark one, crossfading as it changes. A real
 * switch (role="switch", on = dark). The choice persists in
 * localStorage('ef-theme'); Base.astro applies it before paint and again after
 * each client-side navigation; the OS preference is used until then.
 */
interface Props { class?: string; showLabel?: boolean }
const { class: cls = '', showLabel = false } = Astro.props;
---

<button
  type="button"
  class:list={['theme-btn', { 'has-label': showLabel }, cls]}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Dark theme"
>
  <span class="icons" aria-hidden="true">
    <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </span>
  {showLabel && <span class="label" data-theme-label>Light theme</span>}
</button>

<style>
  .theme-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.625rem;
    width: 44px; height: 44px; padding: 0; border: 1px solid var(--line); border-radius: 999px;
    background: var(--surface); color: var(--ink); cursor: pointer;
    font: inherit; font-size: 0.9375rem; font-weight: 500;
    transition: border-color 150ms var(--ease-mech), background-color 150ms var(--ease-mech), color 150ms var(--ease-mech);
  }
  .theme-btn.has-label { width: auto; padding: 0 1rem 0 0.75rem; }
  .theme-btn:hover { border-color: var(--ink); }
  .icons { display: grid; width: 18px; height: 18px; }
  .icon { grid-area: 1 / 1; transition: opacity 220ms var(--ease-mech), transform 360ms var(--ease-mech); }
  .icon-moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .theme-btn[aria-checked="true"] .icon-sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
  .theme-btn[aria-checked="true"] .icon-moon { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .icon { transition: opacity 120ms; transform: none; } }
  /* In the bar only where the page edge (which carries the button) is hidden. */
  @media (min-width: 1320px) { .theme-btn.bar-toggle { display: none; } }
</style>

<script>
  const KEY = 'ef-theme';
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  function resolved(): 'light' | 'dark' {
    const t = document.documentElement.dataset.theme;
    if (t === 'dark' || t === 'light') return t;
    return mq.matches ? 'dark' : 'light';
  }

  function paint() {
    const dark = resolved() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-checked', String(dark));
      const label = btn.querySelector<HTMLElement>('[data-theme-label]');
      if (label) label.textContent = dark ? 'Dark theme' : 'Light theme';
    });
  }

  function toggle() {
    const next = resolved() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem(KEY, next); } catch {}
    paint();
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', toggle);
    });
    paint();
  }

  mq.addEventListener('change', paint);
  document.addEventListener('astro:page-load', init);
  init();
</script>
