---
/**
 * Theme switch. A real switch (role="switch", on = dark) with "Light" and
 * "Dark" either side of the track, the current one inked. The choice persists
 * in localStorage('ef-theme'); Base.astro applies it before paint and again
 * after each client-side navigation; the OS preference is used until then.
 */
interface Props { class?: string; labels?: boolean }
const { class: cls = '', labels = false } = Astro.props;
---

<button
  type="button"
  class:list={['theme-switch', cls]}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Dark theme"
>
  {labels && <span class="tl tl-light" aria-hidden="true">Light</span>}
  <span class="track" aria-hidden="true">
    {!labels && (
      <>
        <svg class="glyph glyph-sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
        <svg class="glyph glyph-moon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
      </>
    )}
    <span class="knob"></span>
  </span>
  {labels && <span class="tl tl-dark" aria-hidden="true">Dark</span>}
</button>

<style>
  .theme-switch {
    display: inline-flex; align-items: center; gap: 0.625rem;
    min-height: 44px; padding: 0 0.25rem; border: 0; background: transparent;
    color: var(--ink-muted); cursor: pointer; font: inherit; font-size: 0.875rem; font-weight: 500;
    border-radius: 999px;
  }
  .tl { transition: color 150ms var(--ease-mech); }
  .theme-switch[aria-checked="false"] .tl-light, .theme-switch[aria-checked="true"] .tl-dark { color: var(--ink); font-weight: 600; }
  .track {
    position: relative; display: block; width: 46px; height: 26px; border-radius: 999px;
    background: var(--line); border: 1px solid transparent;
    transition: background-color 200ms var(--ease-mech), border-color 200ms var(--ease-mech);
  }
  .theme-switch:hover .track { border-color: var(--ink-muted); }
  .glyph { position: absolute; top: 50%; transform: translateY(-50%); color: var(--ink-muted); }
  .glyph-sun { left: 6px; }
  .glyph-moon { right: 6px; }
  .knob {
    position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--bg); box-shadow: 0 1px 2px rgba(11, 27, 43, 0.25);
    transition: transform 240ms var(--ease-mech), background-color 200ms var(--ease-mech);
  }
  .theme-switch[aria-checked="true"] .track { background: var(--ink); }
  .theme-switch[aria-checked="true"] .glyph { color: var(--bg); }
  .theme-switch[aria-checked="true"] .knob { transform: translateX(20px); background: var(--bg); }
  @media (prefers-reduced-motion: reduce) { .knob, .track { transition: none; } }
</style>

<script>
  const KEY = 'ef-theme';
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  function resolved(): 'light' | 'dark' {
    const t = document.documentElement.dataset.theme;
    if (t === 'dark' || t === 'light') return t;
    return mq.matches ? 'dark' : 'light';
  }

  function paint() {
    const dark = resolved() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => btn.setAttribute('aria-checked', String(dark)));
  }

  function toggle() {
    const next = resolved() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem(KEY, next); } catch {}
    paint();
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', toggle);
    });
    paint();
  }

  mq.addEventListener('change', paint);
  document.addEventListener('astro:page-load', init);
  init();
</script>
