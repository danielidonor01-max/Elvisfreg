---
import Photo from './Photo.astro';
import Placeholder from './Placeholder.astro';
import type { Project } from '../data/projects';
import { PROJECT_LEAD } from '../data/project-images';

interface Props { project: Project; headingLevel?: 'h2' | 'h3' }
const { project, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const lead = PROJECT_LEAD[project.slug];
---

<a href={`/projects/${project.slug}/`} class="group block no-underline text-ink">
  {lead
    ? <Photo src={lead.src} alt={lead.alt} ratio="3/2" temp={lead.temp} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw" />
    : <Placeholder label={project.title} ratio="3/2" />}
  <Heading class="h3 mt-4 group-hover:underline underline-offset-4">{project.title}</Heading>
  <p class="data text-ink-muted mt-1">{project.location}</p>
</a>
