---
/**
 * The enquiry form. Posts as a plain HTML form to /api/enquiry (works with JS
 * off); with JS, validates on blur, submits with fetch and swaps in the
 * confirmation in place. `variant="short"` is the three-field home version.
 */
import { SECTORS, SITE } from '../data/site';
import { STAGES } from '../data/stages';
import { serviceBySlug } from '../data/services';

import Button from './Button.astro';
interface Props { variant?: 'full' | 'short'; preselectService?: string; id?: string }
const { variant = 'full', preselectService, id = 'enquiry' } = Astro.props;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<form
  id={id}
  class="grid gap-5"
  method="post"
  action="/api/enquiry/"
  novalidate
  data-enquiry-form
  data-variant={variant}
>
  <div class="error-summary border border-fault rounded-xs p-4 text-[0.9375rem]" role="alert" hidden data-summary>
    <p class="font-medium">Some fields need attention.</p>
    <ul class="list-disc pl-5 mt-2" data-summary-list></ul>
  </div>

  <div class="field">
    <label for={`${id}-name`}>Your name <span class="text-fault" aria-hidden="true">*</span></label>
    <input id={`${id}-name`} name="name" type="text" class="control" required autocomplete="name" data-msg="Enter your name." />
    <p class="error" id={`${id}-name-error`}></p>
  </div>

  {variant === 'full' && (
    <div class="field">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" class="control" autocomplete="organization" />
    </div>
  )}

  <div class:list={['grid gap-5', { 'md:grid-cols-2': variant === 'full' }]}>
    <div class="field">
      <label for={`${id}-email`}>Email <span class="text-fault" aria-hidden="true">*</span></label>
      <input id={`${id}-email`} name="email" type="email" class="control" required autocomplete="email" inputmode="email" data-msg="Enter an email address we can reply to." />
      <p class="error" id={`${id}-email-error`}></p>
    </div>
    {variant === 'full' && (
      <div class="field">
        <label for={`${id}-phone`}>Phone</label>
        <input id={`${id}-phone`} name="phone" type="tel" class="control" autocomplete="tel" inputmode="tel" placeholder="0803 000 0000" />
        <p class="hint">WhatsApp numbers are fine.</p>
      </div>
    )}
  </div>

  {variant === 'full' && (
    <div class="grid gap-5 md:grid-cols-2">
      <div class="field">
        <label for={`${id}-sector`}>Sector <span class="text-fault" aria-hidden="true">*</span></label>
        <select id={`${id}-sector`} name="sector" class="control" required data-msg="Choose the sector this work is in.">
          <option value="">Choose one</option>
          {SECTORS.map((s) => <option value={s}>{s}</option>)}
        </select>
        <p class="error" id={`${id}-sector-error`}></p>
      </div>
      <div class="field">
        <label for={`${id}-service`}>Service needed <span class="text-fault" aria-hidden="true">*</span></label>
        <select id={`${id}-service`} name="service" class="control" required data-msg="Choose the service you need.">
          <option value="">Choose one</option>
          {STAGES.map((st) => (
            <optgroup label={`${st.id} ${st.name}`}>
              {st.services.map((slug) => {
                const s = serviceBySlug(slug)!;
                return <option value={s.slug} selected={s.slug === preselectService}>{s.short}</option>;
              })}
            </optgroup>
          ))}
          <option value="other">Something else</option>
        </select>
        <p class="error" id={`${id}-service-error`}></p>
      </div>
    </div>
  )}

  {variant === 'full' && (
    <div class="field">
      <label for={`${id}-location`}>Site location</label>
      <input id={`${id}-location`} name="location" type="text" class="control" placeholder="City or facility" />
    </div>
  )}

  <div class="field">
    <label for={`${id}-message`}>What do you need? <span class="text-fault" aria-hidden="true">*</span></label>
    <textarea id={`${id}-message`} name="message" class="control" required minlength="10" placeholder="For example: calibration of twelve pressure gauges, 0–100 bar, at our Warri yard." data-msg="Tell us what you need, in a sentence or two."></textarea>
    <p class="error" id={`${id}-message-error`}></p>
  </div>

  <div class="field">
    <label class="flex items-start gap-3 font-normal cursor-pointer">
      <input name="consent" type="checkbox" class="mt-1.5 w-4 h-4 shrink-0 accent-[var(--flame)]" required data-msg="Tick the box so we can reply to you." />
      <span>{SITE.shortName} may contact me about this enquiry. <a href="/privacy/" class="link">How we handle your details</a>.</span>
    </label>
    <p class="error" id={`${id}-consent-error`}></p>
  </div>

  <!-- Honeypot: humans never see it; bots fill it. -->
  <div class="hp" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-size="invisible" data-response-field-name="turnstile"></div>}
  <input type="hidden" name="variant" value={variant} />

  <div class="flex flex-wrap items-center gap-4 pt-1">
    <Button type="submit" variant="primary" data-submit><span data-submit-label>Send enquiry</span></Button>
    {variant === 'short' && <p class="text-[0.9375rem] text-ink-muted">Or call <a href={`tel:${SITE.phoneE164}`} class="link num">{SITE.phoneDisplay}</a></p>}
  </div>

  <div class="status border border-line rounded-md bg-surface p-6" hidden data-status aria-live="polite"></div>
</form>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  function fieldWrap(el: Element) { return el.closest<HTMLElement>('.field'); }

  function setError(input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, msg: string) {
    const wrap = fieldWrap(input);
    if (!wrap) return;
    const err = wrap.querySelector<HTMLElement>('.error');
    wrap.dataset.invalid = msg ? 'true' : 'false';
    if (err) err.textContent = msg;
    if (msg) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
    if (err && msg) input.setAttribute('aria-describedby', err.id);
  }

  function validate(input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string {
    if (input.checkValidity()) { setError(input, ''); return ''; }
    const msg = input.dataset.msg || 'Check this field.';
    setError(input, msg);
    return msg;
  }

  function init() {
    document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input:not([type=hidden]), select, textarea'))
        .filter((c) => c.name !== 'website');
      const summary = form.querySelector<HTMLElement>('[data-summary]')!;
      const summaryList = form.querySelector<HTMLElement>('[data-summary-list]')!;
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

      controls.forEach((c) => {
        c.addEventListener('blur', () => { if (c.value !== '' || c.required) validate(c); });
        c.addEventListener('input', () => { if (fieldWrap(c)?.dataset.invalid === 'true') validate(c); });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errors: { id: string; msg: string }[] = [];
        controls.forEach((c) => { const m = validate(c); if (m) errors.push({ id: c.id, msg: m }); });

        if (errors.length) {
          summaryList.innerHTML = errors.map((er) => `<li><a href="#${er.id}">${er.msg}</a></li>`).join('');
          summary.hidden = false;
          (form.querySelector('#' + errors[0].id) as HTMLElement | null)?.focus();
          return;
        }
        summary.hidden = true;

        submit.disabled = true;
        const labelEl = submit.querySelector<HTMLElement>('[data-submit-label]') || submit;
        const label = labelEl.textContent;
        labelEl.textContent = 'Sending…';
        status.hidden = true;

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) throw new Error(data.error || 'Request failed');

          const email = (form.querySelector<HTMLInputElement>('input[name=email]')?.value ?? '').trim();
          Array.from(form.children).forEach((child) => { if (child !== status) (child as HTMLElement).hidden = true; });
          status.innerHTML = `
            <p class="font-medium text-ok-text flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="check-draw" d="M20 6 9 17l-5-5"/></svg>
              Enquiry sent
            </p>
            <p class="mt-2 text-ink-muted">We'll reply to ${email.replace(/</g, '&lt;')}.</p>`;
          status.hidden = false;
          status.focus?.();
        } catch {
          status.innerHTML = `
            <p class="font-medium text-fault">Couldn't send</p>
            <p class="mt-2 text-ink-muted">Check your connection and try again, or email <a class="link" href="mailto:elvisfregnlgltd@gmail.com">elvisfregnlgltd@gmail.com</a> directly. What you typed is still here.</p>`;
          status.hidden = false;
          submit.disabled = false;
          labelEl.textContent = label;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
<script>
  /**
   * The selects become on-brand listboxes. The native <select> stays in the
   * form (hidden) and keeps the value, so submission, validation and the
   * no-JavaScript path are unchanged; the button and panel are built from it.
   */
  const CHEV = '<svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
  const TICK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

  function enhance(select: HTMLSelectElement) {
    if (select.dataset.enhanced) return;
    select.dataset.enhanced = '1';
    const id = select.id || `sel-${Math.random().toString(36).slice(2, 8)}`;
    const wrap = document.createElement('div');
    wrap.className = 'select';
    select.parentNode!.insertBefore(wrap, select);
    wrap.appendChild(select);
    select.classList.add('select-native');
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');

    const label = document.querySelector<HTMLLabelElement>(`label[for="${id}"]`);
    if (label && !label.id) label.id = `${id}-label`;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'control select-btn';
    btn.id = `${id}-btn`;
    btn.setAttribute('aria-haspopup', 'listbox');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-controls', `${id}-list`);
    if (label) { label.htmlFor = btn.id; btn.setAttribute('aria-labelledby', `${label.id} ${btn.id}`); }
    btn.innerHTML = `<span class="select-value"></span>${CHEV}`;
    const valueEl = btn.querySelector<HTMLElement>('.select-value')!;

    const panel = document.createElement('div');
    panel.className = 'select-panel';
    panel.id = `${id}-list`;
    panel.setAttribute('role', 'listbox');
    panel.tabIndex = -1;
    panel.hidden = true;
    if (label) panel.setAttribute('aria-labelledby', label.id);

    const opts: HTMLElement[] = [];
    const addOption = (o: HTMLOptionElement, into: HTMLElement) => {
      if (o.value === '') return;
      const el = document.createElement('div');
      el.setAttribute('role', 'option');
      el.id = `${id}-opt-${opts.length}`;
      el.dataset.value = o.value;
      el.setAttribute('aria-selected', 'false');
      el.innerHTML = `<span>${o.text}</span>${TICK}`;
      into.appendChild(el);
      opts.push(el);
    };
    Array.from(select.children).forEach((child, gi) => {
      if (child instanceof HTMLOptGroupElement) {
        const g = document.createElement('div');
        g.setAttribute('role', 'group');
        const gl = document.createElement('div');
        gl.className = 'select-group-label';
        gl.id = `${id}-group-${gi}`;
        const m = child.label.match(/^(\d+)\s+(.*)$/);
        gl.innerHTML = m ? `<span class="data">${m[1]}</span><span>${m[2]}</span>` : child.label;
        g.setAttribute('aria-labelledby', gl.id);
        g.appendChild(gl);
        Array.from(child.children).forEach((o) => addOption(o as HTMLOptionElement, g));
        panel.appendChild(g);
      } else if (child instanceof HTMLOptionElement) {
        addOption(child, panel);
      }
    });
    wrap.append(btn, panel);

    let active = -1;
    let typed = '';
    let typedAt = 0;
    const placeholder = select.options[0]?.value === '' ? select.options[0].text : 'Choose one';

    const sync = () => {
      const current = opts.find((o) => o.dataset.value === select.value);
      valueEl.textContent = current ? current.firstChild!.textContent : placeholder;
      btn.classList.toggle('is-placeholder', !current);
      opts.forEach((o) => o.setAttribute('aria-selected', String(o === current)));
      if (select.getAttribute('aria-invalid') === 'true') btn.setAttribute('aria-invalid', 'true'); else btn.removeAttribute('aria-invalid');
    };
    const setActive = (i: number) => {
      active = i;
      opts.forEach((o, j) => o.classList.toggle('is-active', j === i));
      if (i >= 0) { panel.setAttribute('aria-activedescendant', opts[i].id); opts[i].scrollIntoView({ block: 'nearest' }); }
      else panel.removeAttribute('aria-activedescendant');
    };
    const open = () => {
      if (!panel.hidden) return;
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      const r = btn.getBoundingClientRect();
      panel.classList.toggle('is-up', window.innerHeight - r.bottom < 320 && r.top > 320);
      const cur = opts.findIndex((o) => o.dataset.value === select.value);
      setActive(cur >= 0 ? cur : 0);
      panel.focus({ preventScroll: true });
    };
    const close = (focusBtn = false) => {
      if (panel.hidden) return;
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      setActive(-1);
      if (focusBtn) btn.focus();
      select.dispatchEvent(new Event('blur'));
    };
    const choose = (i: number) => {
      const v = opts[i].dataset.value!;
      if (select.value !== v) {
        select.value = v;
        select.dispatchEvent(new Event('input', { bubbles: true }));
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
      sync();
      close(true);
    };

    btn.addEventListener('click', () => (panel.hidden ? open() : close(true)));
    btn.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) { e.preventDefault(); open(); }
    });
    panel.addEventListener('keydown', (e) => {
      const n = opts.length;
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive((active + 1) % n); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive((active - 1 + n) % n); }
      else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
      else if (e.key === 'End') { e.preventDefault(); setActive(n - 1); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (active >= 0) choose(active); }
      else if (e.key === 'Escape') { e.preventDefault(); close(true); }
      else if (e.key === 'Tab') { close(); }
      else if (e.key.length === 1 && /\S/.test(e.key)) {
        const now = Date.now();
        typed = now - typedAt < 700 ? typed + e.key.toLowerCase() : e.key.toLowerCase();
        typedAt = now;
        const start = typed.length === 1 ? active + 1 : active;
        for (let k = 0; k < n; k++) {
          const j = (start + k) % n;
          if ((opts[j].textContent || '').trim().toLowerCase().startsWith(typed)) { setActive(j); break; }
        }
      }
    });
    opts.forEach((o, i) => {
      o.addEventListener('click', () => choose(i));
      o.addEventListener('mousemove', () => { if (active !== i) setActive(i); });
    });
    document.addEventListener('pointerdown', (e) => { if (!wrap.contains(e.target as Node)) close(); });
    panel.addEventListener('focusout', (e) => { if (!wrap.contains(e.relatedTarget as Node)) close(); });
    select.addEventListener('change', sync);
    select.form?.addEventListener('reset', () => setTimeout(sync));
    new MutationObserver(sync).observe(select, { attributes: true, attributeFilter: ['aria-invalid'] });
    sync();
  }

  function initSelects() {
    document.querySelectorAll<HTMLSelectElement>('[data-enquiry-form] select.control').forEach(enhance);
  }
  document.addEventListener('astro:page-load', initSelects);
  initSelects();
</script>
