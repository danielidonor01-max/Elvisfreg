---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: site + c.href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-[0.9375rem] text-ink-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 list-none m-0 p-0">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.href ? <a href={c.href} class="link-quiet hover:text-ink transition-colors">{c.label}</a> : <span aria-current="page" class="text-ink">{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
