---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" description="The page you asked for isn't here." path="/404/" noindex>
  <section class="wrap py-20 md:py-28 grid gap-10 lg:grid-cols-12 items-center">
    <div class="lg:col-span-8" data-reveal>
      <p class="data text-ink-muted">404</p>
      <h1 class="h1 mt-3">That page isn't here</h1>
      <p class="measure mt-6 text-ink-muted text-[1.125rem]">The address may be wrong, or the page has moved. The services and projects indexes cover everything on the site.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/" variant="primary">Home</Button>
        <Button href="/services/">Services</Button>
        <Button href="/projects/">Projects</Button>
      </div>
    </div>
  </section>
</Base>
