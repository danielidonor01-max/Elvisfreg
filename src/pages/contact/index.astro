---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { SITE, OFFICES } from '../../data/site';

const description = 'Request a quotation from Elvisfreg Nigeria Limited. Offices in Warri, Lagos and Houston. Phone, WhatsApp and email.';
const hq = OFFICES.find((o) => o.isHq)!;
const origin = Astro.site?.toString().replace(/\/$/, '') ?? '';

const jsonLd = [{
  '@type': 'ProfessionalService',
  '@id': origin + '/contact/#warri',
  name: `${SITE.name}, ${hq.name}`,
  parentOrganization: { '@id': origin + '/#organization' },
  image: origin + '/favicon.svg',
  telephone: SITE.phoneE164,
  email: SITE.email,
  url: origin + '/contact/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: hq.lines[0],
    addressLocality: hq.city,
    addressRegion: hq.region,
    addressCountry: hq.country,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  }],
}];
---

<Base title="Request a quotation" description={description} path="/contact/" jsonLd={jsonLd} mobileBar={false}>
  <div class="wrap pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  </div>

  <section class="wrap pt-10 pb-16 md:pt-14 md:pb-24 grid gap-14 lg:grid-cols-12 lg:gap-16 items-start">
    <div class="lg:col-span-7">
      <h1 class="h1">Request a quotation</h1>
      <p class="measure mt-6 text-[1.125rem] text-ink-muted">Tell us about the site and what you need. We'll reply by email with questions or a quotation.</p>
      <div class="mt-10">
        <EnquiryForm variant="full" id="enquiry" />
      </div>
    </div>

    <aside class="lg:col-span-5 lg:pt-4">
      <h2 class="h3">Reach us directly</h2>
      <ul class="list-none m-0 p-0 mt-4 flex flex-col gap-2">
        <li><a href={`tel:${SITE.phoneE164}`} class="link num">{SITE.phoneDisplay}</a></li>
        <li><a href={SITE.whatsapp} target="_blank" rel="noopener" class="link">Message us on WhatsApp</a></li>
        <li><a href={`mailto:${SITE.email}`} class="link break-words">{SITE.email}</a></li>
      </ul>

      <h2 class="h3 mt-12" id="offices">Offices</h2>
      <dl class="mt-4 grid gap-6 m-0" data-reveal-group>
        {OFFICES.map((o) => (
          <div>
            <dt class="font-medium">{o.name}</dt>
            <dd class="m-0"><address class="not-italic text-ink-muted">{o.lines.map((l) => <span class="block">{l}</span>)}</address></dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>
</Base>

<script>
  // Arriving from a service page: ?service=<slug> pre-fills the select.
  function preselect() {
    const slug = new URLSearchParams(location.search).get('service');
    if (!slug) return;
    const select = document.querySelector<HTMLSelectElement>('select[name=service]');
    if (select && Array.from(select.options).some((o) => o.value === slug)) select.value = slug;
  }
  document.addEventListener('astro:page-load', preselect);
  preselect();
</script>
