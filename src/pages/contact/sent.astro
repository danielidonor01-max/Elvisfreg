---
// Confirmation for the no-JavaScript submission path. With JS, the form
// confirms in place and never navigates here.
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
---

<Base title="Enquiry sent" description="Your enquiry has been sent to Elvisfreg Nigeria Limited." path="/contact/sent/" noindex>
  <section class="wrap py-20 md:py-28">
    <p class="font-medium text-ok-text flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      Enquiry sent
    </p>
    <h1 class="h1 mt-4">We'll reply by email</h1>
    <p class="measure mt-6 text-ink-muted text-[1.125rem]">If it's urgent, call <a href={`tel:${SITE.phoneE164}`} class="link num">{SITE.phoneDisplay}</a> or <a href={SITE.whatsapp} target="_blank" rel="noopener" class="link">message us on WhatsApp</a>.</p>
    <p class="mt-10"><a href="/" class="btn">Back to the home page</a></p>
  </section>
</Base>
