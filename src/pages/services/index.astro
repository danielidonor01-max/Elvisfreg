---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import { STAGES } from '../../data/stages';
import { SERVICES } from '../../data/services';
import { SERVICE_LEAD } from '../../data/service-images';

const description = 'Electrical, automation and control, control panels, power systems, instrumentation and calibration, hydrotest and maintenance services for Nigerian industry.';
// Each service listed once, under its primary stage.
const byStage = STAGES.map((stage) => ({ stage, services: SERVICES.filter((s) => s.stages[0] === stage.id) })).filter((g) => g.services.length);
---

<Base title="Services" description={description} path="/services/">
  <div class="wrap pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
  </div>

  <section class="wrap pt-10 pb-12 md:pt-14 md:pb-16 grid gap-8 lg:grid-cols-12 lg:gap-16 items-end">
    <div class="lg:col-span-7">
      <h1 class="h1">Services</h1>
      <p class="measure mt-6 text-[1.125rem] text-ink-muted">Seven service families, grouped by the stage of the asset lifecycle they serve. Most projects draw on more than one, from a single accountable partner.</p>
    </div>
    <nav class="lg:col-span-5" aria-label="Stages on this page">
      <p class="text-[0.9375rem] text-ink-muted">Jump to a stage</p>
      <ul class="list-none m-0 p-0 mt-3 flex flex-wrap gap-2">
        {byStage.map(({ stage }) => (
          <li>
            <a href={`#${stage.slug}`} class="chip">
              <span class="data" aria-hidden="true">{stage.id}</span>
              <span class="sr-only">Stage {stage.id}, </span>
              <span>{stage.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {byStage.map(({ stage, services }, i) => (
    <section id={stage.slug} class:list={['border-t border-line scroll-mt-24', { band: i % 2 === 1, 'cv-auto': i > 0 }]}>
      <div class="wrap py-14 md:py-20">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-16 items-end" data-reveal>
          <div class="lg:col-span-7">
            <p class="data text-ink-muted"><span aria-hidden="true">{stage.id}</span><span class="sr-only">Stage {stage.id}</span><span class="ml-3 font-sans text-[0.9375rem]">{stage.name}</span></p>
            <h2 class="h2 mt-2">{stage.headline}</h2>
            <p class="mt-4 text-ink-muted measure">{stage.body}</p>
          </div>
          <div class="lg:col-span-5 lg:justify-self-end">
            <Button href={`/contact/?service=${stage.services[0]}`}>{stage.cta}</Button>
          </div>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8" data-reveal-group>
          {services.map((s) => {
            const img = SERVICE_LEAD[s.slug];
            return (
              <article class:list={['svc-card', { 'svc-card--wide': services.length === 1 }]}>
                <Photo src={img.src} alt={img.alt} ratio="3/2" temp={img.temp} parallax sizes="(min-width: 768px) 50vw, 100vw" />
                <div class="svc-body">
                  <h3 class="h3">{s.title}</h3>
                  <p class="mt-3 text-ink-muted">{s.summary}</p>
                  <div class="mt-6">
                    <Button href={`/services/${s.slug}/`}>See the service</Button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    id="not-sure"
    title="Not sure which service you need?"
    body="Describe the site and the problem. We will tell you which of these it is, or whether it is more than one, and quote for it."
    action={{ label: 'Request a quote', href: '/contact/' }}
    side={{ title: 'Questions, answered by stage.', body: 'What we need before design starts, what is tested before energisation, what a calibration certificate shows.', href: '/help/' }}
  />
</Base>
