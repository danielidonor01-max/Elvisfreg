---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { STAGES } from '../../data/stages';
import { SERVICES } from '../../data/services';

const description = 'Electrical, automation and control, control panels, power systems, instrumentation and calibration, hydrotest and maintenance services for Nigerian industry.';
// Each service listed once, under its primary stage.
const byStage = STAGES.map((stage) => ({ stage, services: SERVICES.filter((s) => s.stages[0] === stage.id) })).filter((g) => g.services.length);
---

<Base title="Services" description={description} path="/services/">
  <div class="wrap pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
  </div>

  <section class="wrap pt-10 pb-14 md:pt-14 md:pb-20">
    <h1 class="h1">Services</h1>
    <p class="measure mt-6 text-[1.125rem] text-ink-muted">Seven service families, grouped by the stage of the asset lifecycle they serve. Most projects draw on more than one, from a single accountable partner. Questions about a stage are answered in <a href="/help/" class="link">help</a>.</p>
  </section>

  {byStage.map(({ stage, services }) => (
    <section class="border-t border-line">
      <div class="wrap py-14 md:py-20 grid gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4" data-reveal>
          <p class="data text-ink-muted"><span aria-hidden="true">{stage.id}</span><span class="sr-only">Stage {stage.id}</span><span class="ml-3 font-sans text-[0.9375rem]">{stage.name}</span></p>
          <h2 class="h2 mt-2">{stage.headline}</h2>
          <p class="mt-4 text-ink-muted">{stage.body}</p>
        </div>
        <div class="lg:col-span-8 grid gap-10 md:grid-cols-2" data-reveal-group>
          {services.map((s) => (
            <article class="group">
              <h3 class="h3"><a href={`/services/${s.slug}/`} class="link-quiet">{s.title}</a></h3>
              <p class="mt-3 text-ink-muted">{s.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>
