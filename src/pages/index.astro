---
import Base from '../layouts/Base.astro';
import Arc from '../components/Arc.astro';
import ArcSelector from '../components/ArcSelector.astro';
import ProofStrip from '../components/ProofStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CalibrationRecord from '../components/CalibrationRecord.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { SITE, CLIENTS } from '../data/site';
import { PROJECTS } from '../data/projects';

const featured = PROJECTS.filter((p) => p.featured).slice(0, 3);
---

<Base title="Home" description={SITE.description} path="/">
  <!-- Hero -->
  <section class="wrap pt-14 pb-16 md:pt-20 md:pb-24 grid gap-12 lg:grid-cols-12 lg:gap-16 items-center">
    <div class="lg:col-span-7">
      <h1 class="display max-w-[16ch]">{SITE.tagline}</h1>
      <p class="measure mt-7 text-[1.125rem] md:text-[1.25rem] text-ink-muted leading-relaxed">
        Design, installation, PLC and HMI programming, instrument calibration and maintenance for oil and gas, power and manufacturing sites across Nigeria.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href="/contact/" class="btn btn-primary">Request a quote</a>
        <a href={SITE.profilePdf} class="link">Download company profile (PDF)</a>
      </div>
      <p class="data text-ink-muted mt-10"><span class="whitespace-nowrap">Incorporated {SITE.incorporatedLabel}</span><span class="mx-3" aria-hidden="true">/</span><span class="whitespace-nowrap">RC {SITE.rc}</span></p>
    </div>
    <div class="lg:col-span-5">
      <Arc playOnLoad transitionName="arc" label="Elvisfreg Precision Spectrum Arc" class="max-w-[420px] mx-auto lg:ml-auto lg:mr-0" />
    </div>
  </section>

  <ProofStrip />

  <!-- Lifecycle selector -->
  <section class="section wrap">
    <h2 class="h2 max-w-[24ch]">What we do, by stage of the asset lifecycle</h2>
    <p class="measure mt-4 text-ink-muted">Each petal of the mark is a stage of the engineering lifecycle. Choose one to see the services that belong to it.</p>
    <div class="mt-12">
      <ArcSelector initial="03" />
    </div>
  </section>

  <!-- Recent work -->
  <section class="border-t border-line">
    <div class="section wrap">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="h2">Recent work</h2>
        <a href="/projects/" class="link">All projects</a>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- QA method -->
  <section class="border-t border-line">
    <div class="section wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6 prose">
        <h2 class="h2">How we verify our own work</h2>
        <p class="text-ink-muted">A calibration is only worth what its record can prove. Ours are built the same way every time.</p>
        <ul>
          <li><strong>As-found data first.</strong> The instrument's state is recorded before anything is adjusted, so previous work with the device can be evaluated.</li>
          <li><strong>Multi-point testing</strong> at 0, 25, 50, 75 and 100 percent of full-scale span, following a defined procedure.</li>
          <li><strong>As-left data recorded</strong> after adjustment, maintenance or repair.</li>
          <li><strong>Expanded uncertainty</strong> calculated from reference standard uncertainty, environmental drift and instrument resolution.</li>
          <li><strong>Proficiency testing and inter-laboratory comparison</strong> against international calibration facilities, so our procedures are validated against something outside ourselves.</li>
        </ul>
        <p><a href="/services/instrumentation-calibration/" class="link">Instrumentation and calibration</a></p>
      </div>
      <div class="lg:col-span-6 lg:pt-14">
        <CalibrationRecord />
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="border-t border-line">
    <div class="section wrap">
      <h2 class="h2">Clients and partners</h2>
      <ul class="list-none m-0 p-0 mt-8 flex flex-wrap gap-x-8 gap-y-3 text-ink-muted max-w-[80ch]">
        {CLIENTS.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="border-t border-line">
    <div class="section wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="h2">Send an enquiry</h2>
        <p class="measure mt-4 text-ink-muted">A sentence or two is enough to start. We'll come back with questions or a quotation.</p>
        <ul class="list-none m-0 p-0 mt-8 flex flex-col gap-2">
          <li><a href={`tel:${SITE.phoneE164}`} class="data link">{SITE.phoneDisplay}</a></li>
          <li><a href={SITE.whatsapp} target="_blank" rel="noopener" class="link">Message us on WhatsApp</a></li>
          <li><a href={`mailto:${SITE.email}`} class="link break-all">{SITE.email}</a></li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <EnquiryForm variant="short" id="enquiry-home" />
      </div>
    </div>
  </section>
</Base>
