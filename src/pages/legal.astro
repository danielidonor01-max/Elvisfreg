---
// Draft for legal review.
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE, OFFICES, CERTIFICATIONS } from '../data/site';
const hq = OFFICES.find((o) => o.isHq)!;
---

<Base title="Company information" description="Registered details of Elvisfreg Nigeria Limited, the operator of this website." path="/legal/">
  <div class="wrap pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Company information' }]} />
  </div>
  <section class="wrap pt-10 pb-20 md:pt-14 md:pb-28">
    <h1 class="h1">Company information</h1>
    <p class="measure mt-6 text-[1.125rem] text-ink-muted">The registered details of the company that operates this website.</p>

    <dl class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-2 max-w-[70ch] m-0">
      <div><dt class="text-[0.9375rem] text-ink-muted">Registered name</dt><dd class="m-0 mt-1">{SITE.legalName}</dd></div>
      <div><dt class="text-[0.9375rem] text-ink-muted">Registration number</dt><dd class="m-0 mt-1 data">RC {SITE.rc}</dd></div>
      <div><dt class="text-[0.9375rem] text-ink-muted">Incorporated</dt><dd class="m-0 mt-1">{SITE.incorporatedLabel}, under the Companies and Allied Matters Act</dd></div>
      <div><dt class="text-[0.9375rem] text-ink-muted">Ownership</dt><dd class="m-0 mt-1">Wholly Nigerian-owned</dd></div>
      <div><dt class="text-[0.9375rem] text-ink-muted">Registered office</dt><dd class="m-0 mt-1"><address class="not-italic">{hq.lines.map((l) => <span class="block">{l}</span>)}</address></dd></div>
      <div><dt class="text-[0.9375rem] text-ink-muted">Contact</dt><dd class="m-0 mt-1"><a href={`tel:${SITE.phoneE164}`} class="link num">{SITE.phoneDisplay}</a><br /><a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a></dd></div>
      <div class="md:col-span-2"><dt class="text-[0.9375rem] text-ink-muted">Registrations and memberships</dt><dd class="m-0 mt-1"><ul class="list-none m-0 p-0">{CERTIFICATIONS.slice(0, 3).map((c) => <li>{c.name} — {c.detail}</li>)}</ul></dd></div>
    </dl>

    <p class="measure mt-10 text-ink-muted">Other offices are listed on the <a href="/contact/#offices" class="link">contact page</a>. Legal pages: <a href="/privacy/" class="link">privacy policy</a>, <a href="/terms/" class="link">terms of use</a>, <a href="/cookies/" class="link">cookie notice</a>, <a href="/accessibility/" class="link">accessibility</a>.</p>
  </section>
</Base>
