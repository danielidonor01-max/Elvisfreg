---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ClientWall from '../components/ClientWall.astro';
import { SITE, VALUES, CERTIFICATIONS } from '../data/site';

const description = 'Elvisfreg Nigeria Limited is an indigenous engineering services firm incorporated in August 2025 (RC 8734614), 100% Nigerian-owned, serving oil and gas, power and manufacturing.';
---

<Base title="Company" description={description} path="/company/">
  <div class="wrap pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Company' }]} />
  </div>

  <section class="wrap pt-10 pb-16 md:pt-14 md:pb-20 grid gap-10 lg:grid-cols-12 lg:gap-16 items-start">
    <div class="lg:col-span-8 prose" data-reveal>
      <h1 class="h1">Company</h1>
      <p class="text-[1.125rem] text-ink-muted">{SITE.name} is an indigenous engineering services and industrial technology firm, incorporated in {SITE.incorporatedLabel} under the Companies and Allied Matters Act, RC {SITE.rc}. The company is wholly Nigerian-owned.</p>
      <p>We engineer electrical, power, automation, instrumentation and control systems for oil and gas, heavy manufacturing, power generation and commercial infrastructure. Our work covers design, installation, commissioning, maintenance, troubleshooting and upgrading, across conventional electrical installations and modern industrial automation: programmable logic controllers, human-machine interfaces, variable frequency drives, sensors, motor control systems and generator control panels.</p>
      <p>Our objective is plain: electrical and automation systems that are safe, reliable, energy-efficient, maintainable and fit for purpose, delivered to the applicable standard and the client's specification.</p>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="section wrap grid gap-12 md:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="h2">Vision</h2>
        <p class="measure mt-4 text-ink-muted">To be West Africa's most trusted benchmark in high-integrity electrical engineering and intelligent industrial automation, powering critical infrastructure with absolute reliability, safety and operational precision.</p>
      </div>
      <div>
        <h2 class="h2">Mission</h2>
        <p class="measure mt-4 text-ink-muted">To engineer, integrate and sustain robust electrical and automation architectures that eliminate downtime, maximise energy efficiency, safeguard operational personnel and elevate Nigeria's industrial self-reliance.</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="section wrap">
      <h2 class="h2">Values</h2>
      <p class="measure mt-4 text-ink-muted">Five principles, one for each letter of PRIME.</p>
      <dl class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-5 m-0" data-reveal-group>
        {VALUES.map((v) => (
          <div class="border-t border-line pt-4">
            <dt class="flex items-baseline gap-3">
              <span class="text-flame-text font-bold text-[1.5rem] leading-none" aria-hidden="true">{v.letter}</span>
              <span class="font-medium">{v.name}</span>
            </dt>
            <dd class="m-0 mt-2 text-[0.9375rem] text-ink-muted">{v.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="section wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="h2">Certification and assurance</h2>
        <dl class="mt-8 grid gap-5 m-0">
          {CERTIFICATIONS.map((c) => (
            <div>
              <dt class="font-medium">{c.name}</dt>
              <dd class="m-0 text-[0.9375rem] text-ink-muted">{c.detail}</dd>
            </div>
          ))}
        </dl>
        <p class="measure mt-8 text-ink-muted">Our testing engineers, Nigerian and foreign-based, are qualified in the company's areas of service. The purpose is to improve the reliability of the client's plant: less rework, more uptime.</p>
      </div>
      <div class="lg:col-span-7 prose">
        <h2 class="h2">Nigerian content</h2>
        <p class="text-ink-muted">The company runs a Nigerian Content Plan in all its activities.</p>
        <ul>
          <li>Work is executed by Nigerian personnel, roughly 90 percent of the workforce, with foreign specialists engaged where a need arises.</li>
          <li>Training is organised internally and externally; Nigerian staff understudy expatriates so technical know-how transfers.</li>
          <li>Goods and materials are sourced from local manufacturers wherever quality allows.</li>
          <li>Alliances with international companies bring specific expertise and train local resources.</li>
          <li>Partnerships with competent local firms build capacity and diversify operations.</li>
          <li>A student mentorship and industrial training programme gives hands-on experience and strengthens the academic institutions we work with.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="section wrap">
      <h2 class="h2">Clients and partners</h2>
      <div class="mt-10">
        <ClientWall variant="grid" />
      </div>
      <p class="mt-10"><a href={SITE.profilePdf} class="btn">Download company profile (PDF)
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M4 20h16"/></svg>
      </a></p>
    </div>
  </section>
</Base>
