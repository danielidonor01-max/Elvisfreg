---
import Base from '../../layouts/Base.astro';
---

<Base title="You're on the list" description="Updates sign-up received." path="/updates/sent/" noindex mobileBar={false}>
  <section class="wrap pt-20 pb-24 md:pt-28 md:pb-32">
    <p class="data text-ink-muted">Received</p>
    <h1 class="h1 mt-3">You're on the list.</h1>
    <p class="measure mt-6 text-[1.125rem] text-ink-muted">We'll write when there is something worth reading, and you can leave at any time by replying to say so.</p>
    <p class="mt-10"><a href="/" class="link">Back to the home page</a></p>
  </section>
</Base>
