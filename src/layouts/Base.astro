---
import '@fontsource-variable/outfit';
import '@fontsource-variable/jetbrains-mono';
// The display headline is the LCP element on every page and needs Outfit;
// preloading the latin file lets it paint on the first pass.
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import LockupSprite from '../components/LockupSprite.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  preloader?: boolean;
}
const { title, description, path, noindex, ogType, jsonLd, preloader = false } = Astro.props;
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme, before paint: an explicit choice wins; otherwise the OS decides via CSS. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ef-theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fffbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1b2b" media="(prefers-color-scheme: dark)" />
    <Seo title={title} description={description} path={path} noindex={noindex} ogType={ogType} jsonLd={jsonLd} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-dvh">
    <LockupSprite />
    {preloader && <Preloader />}
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // The motion layer (GSAP, ScrollTrigger, Lenis) loads after the page's own
      // content so it never competes with the hero image for bandwidth.
      const startMotion = () => { import('../scripts/motion'); };
      if (document.readyState === 'complete') startMotion();
      else window.addEventListener('load', startMotion, { once: true });
    </script>
    <script>
      // The arc seal: petals rise once per session on the home hero.
      function playArcs() {
        document.querySelectorAll<HTMLElement>('.arc[data-play]').forEach((el) => {
          let played = false;
          try { played = sessionStorage.getItem('ef-arc-played') === '1'; } catch {}
          if (played) return;
          try { sessionStorage.setItem('ef-arc-played', '1'); } catch {}
          // Wait for the preloader's exit if one is running.
          const start = () => { el.classList.add('is-playing'); window.setTimeout(() => el.classList.remove('is-playing'), 900); };
          if (document.documentElement.classList.contains('is-preloading')) document.addEventListener('ef:preloaded', start, { once: true });
          else start();
        });
      }
      document.addEventListener('astro:page-load', playArcs);
      // Move focus to main after a client-side navigation so screen readers land on content.
      document.addEventListener('astro:after-swap', () => {
        const main = document.getElementById('main');
        if (main) main.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: 1rem; top: -100px; z-index: 100; padding: 0.625rem 1rem; background: var(--flame); color: #0b1b2b; border-radius: var(--radius-xs); font-weight: 500; text-decoration: none; }
  .skip:focus { top: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
