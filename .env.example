# Enquiry form — all optional in development. Without RESEND_API_KEY the endpoint
# validates and logs the enquiry instead of sending it.
RESEND_API_KEY=
ENQUIRY_TO=elvisfregnlgltd@gmail.com
ENQUIRY_FROM=Elvisfreg website <enquiries@elvisfreg.com>

# Cloudflare Turnstile — leave both blank to skip the check in development.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
